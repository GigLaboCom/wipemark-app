[Desktop Entry]
Type=Application
Name=Wipemark
GenericName=AI provenance remover
Comment=Strips AI provenance marks from your own content
Exec=wipemark
Icon=wipemark
Terminal=false
StartupNotify=true
Categories=Utility;TextTools;
Keywords=watermark;provenance;unicode;invisible;C2PA;rewrite;
# One string names the binary, this file, the icon, the X11 WM_CLASS and the
# Wayland app_id: `wipemark` (D605). A dock and Alt+Tab join a running window
# to this file by WM_CLASS / app_id, through StartupWMClass when the file was
# renamed on its way in (an AppImage integrator does rename it). The windows
# must set the app_id for that to hold — WindowOptions::app_id, see
# dev/architecture/packaging.md, "The app_id".
StartupWMClass=wipemark
