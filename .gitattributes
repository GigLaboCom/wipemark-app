# Every text file is checked out with LF, on every platform. Git for
# Windows checks text out with CRLF by default (core.autocrlf=true), and so
# do GitHub's Windows runners: the prompt templates the build takes in with
# include_str! would then be other templates, their hashes "stale" against
# the shipped ones, and a file a test compares byte for byte would gain a
# carriage return on every line. What git reads as binary is never
# converted; the rules below this one name what must never be, whatever
# its first bytes look like.
* text=auto eol=lf

# Pictures, icons and the visible marks' alpha maps: binary everywhere.
*.png                               binary
*.jpg                               binary
*.jpeg                              binary
*.webp                              binary
*.tif                               binary
*.tiff                              binary
*.ico                               binary
*.icns                              binary
*.wma                               binary

# A patch is applied to upstream's tree byte for byte, so its line endings
# are never converted: Git for Windows would give it CRLF, and `git apply`
# refuses that copy.
*.patch                             -text

# Unicode data, crates/wipemark-core/ucd/: byte-exact, because
# SHA256SUMS hashes these bytes and build.rs refuses a carriage return;
# and never diffed, because a version bump is megabytes nobody reads —
# the checksum file (diffable) and the suite are what gets reviewed.
crates/wipemark-core/ucd/**/*.txt   -text -diff
crates/wipemark-core/ucd/SHA256SUMS -text

# Fixtures are byte-exact: a normalised line ending is a changed fixture
# (fixtures/README.md, rule 1). E1-3 adds the files.
fixtures/text/**                    -text

# Image fixtures (E11-1): byte-exact containers whose CRCs, RIFF sizes
# and marker lengths are the point. Never normalised, never diffed.
fixtures/image/*.jpg                binary
fixtures/image/*.png                binary
fixtures/image/*.webp               binary
fixtures/image/gemini/*.jpg         binary
fixtures/image/gemini/*.png         binary
fixtures/image/gemini/*.webp        binary
fixtures/image/grok-x/*.jpeg        binary

# The windows' clean against the CLI's (W9): byte-exact inputs — a UTF-16
# file, a soft hyphen, a TIFF head — and the table both tests read.
fixtures/clean-parity/**            -text -diff
fixtures/image/jpeg-planes/*.jpg    binary

# The carried gpui-pre-linux is the published crate byte for byte plus its
# patch: scripts/check-gpui-pin.sh compares the bytes, so no checkout may
# normalise a line ending in either (D621).
vendor/gpui-pre-linux/**            -text
vendor/gpui-pre-linux.patch         -text
