+ *
+ * This software is free software;
+ *
+ * You can redistribute it or modify it under terms of the MIT, Apache License or Zlib license
+ */
+
+//! The stored planes of a JPEG: each component at its own resolution, as
+//! the IDCT left it, before any upsampling or colour conversion; and the
+//! quantisation tables.
+//!
+//! Not upstream. Added on `GigLaboCom/zune-image`, branch
+//! `wipemark/planes`, for Wipemark's restoration of a visible mark at the
+//! chroma's own resolution; see `PATCH.md` at the root of the repository.
+
+use alloc::vec;
+use alloc::vec::Vec;
+
+use zune_core::bytestream::ZByteReaderTrait;
+
+use crate::decoder::MAX_COMPONENTS;
+use crate::errors::DecodeErrors;
+use crate::JpegDecoder;
+
+/// A JPEG's components as stored: after dequantisation and the IDCT
+/// (whose output is clamped to 0–255), before upsampling and colour
+/// conversion, each cropped from the MCU padding to its own size.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct JpegPlanes {
+    /// The frame's width, in pixels.
+    pub width:            usize,
+    /// The frame's height, in pixels.
+    pub height:           usize,
+    /// One per component, in frame order: Y, Cb, Cr for a YCbCr picture,
+    /// Y alone for a grey one. What the components mean is the input
+    /// colorspace's ([`JpegDecoder::input_colorspace`]): an Adobe RGB
+    /// JPEG's three are R, G and B.
+    pub components:       Vec<PlaneOut>,
+    /// The quantisation tables by slot (0–3), as the file defined them
+    /// before the first scan, in **natural** (row-major) order — not the
+    /// zigzag order the DQT segment stores them in. A slot the file did
+    /// not define is `None`.
+    pub qt:               [Option<[u16; 64]>; 4],
+    /// The restart interval, in MCUs; 0 when the file has none.
+    pub restart_interval: u16,
+    /// Whether the frame is progressive (SOF2).
+    pub progressive:      bool,
+}
+
+/// One component's plane.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlaneOut {
+    /// The component's identifier in the frame header.
+    pub id:       u8,
+    /// Its horizontal sampling factor.
+    pub h:        u8,
+    /// Its vertical sampling factor.
+    pub v:        u8,
+    /// Which quantisation table (slot of [`JpegPlanes::qt`]) it uses.
+    pub qt_index: u8,
+    /// `ceil(width · h / h_max)`: the MCU padding cropped.
+    pub width:    usize,
+    /// `ceil(height · v / v_max)`: the MCU padding cropped.
+    pub height:   usize,
+    /// `width × height` samples, row-major.
+    pub samples:  Vec<u8>,
+}
+
+/// A plane being filled, one row of MCUs at a time.
+pub(crate) struct PlaneBuf {
+    width:   usize,
+    height:  usize,
+    samples: Vec<u8>,
+}
+
+impl<T: ZByteReaderTrait> JpegDecoder<T> {
+    /// Decode the picture to its stored planes rather than to pixels.
+    ///
+    /// The entropy decoding, dequantisation and IDCT are the ones
+    /// [`decode`](Self::decode) runs; what is skipped is everything after
+    /// them — upsampling and colour conversion. A plane is cropped to
+    /// `ceil(width · h / h_max) × ceil(height · v / v_max)`; the samples in
+    /// the MCU padding beyond that are dropped. Rows a damaged scan never
+    /// reached are 128, as `decode` fills them.
+    ///
+    /// Like `decode`, it is called once per decoder.
+    ///
+    /// # Errors
+    /// What [`decode`](Self::decode) refuses (arithmetic coding included),
+    /// and a quantisation value that does not fit in 16 bits.
+    // Sampling factors are 1–4, checked when the frame header is read.
+    #[allow(clippy::cast_possible_truncation)]
+    pub fn decode_planes(&mut self) -> Result<JpegPlanes, DecodeErrors> {
+        self.decode_headers()?;
+
+        // The tables the components take when decoding starts
+        // (`setup_component_params` copies them then), so a DQT between
+        // later scans, which the decoder does not apply either, is not here.
+        let mut qt = [None; MAX_COMPONENTS];
+        for (slot, table) in qt.iter_mut().zip(self.qt_tables.iter()) {
+            if let Some(table) = table {
+                let mut values = [0_u16; 64];
+                for (value, &stored) in values.iter_mut().zip(table.iter()) {
+                    *value = u16::try_from(stored).map_err(|_| {
+                        DecodeErrors::FormatStatic("Quantization value does not fit in 16 bits")
+                    })?;
+                }
+                *slot = Some(values);
+            }
+        }
+
+        self.want_planes = true;
+        self.planes.clear();
+        let mut no_pixels: [u8; 0] = [];
+        let decoded = if self.is_progressive {
+            self.decode_mcu_ycbcr_progressive(&mut no_pixels)
+        } else {
+            self.decode_mcu_ycbcr_baseline(&mut no_pixels)
+        };
+        self.want_planes = false;
+        decoded?;
+
+        let planes = core::mem::take(&mut self.planes);
+        if planes.len() != self.components.len() {
+            return Err(DecodeErrors::FormatStatic("No row of MCUs was decoded"));
+        }
+        let components = self
+            .components
+            .iter()
+            .zip(planes)
+            .map(|(comp, plane)| PlaneOut {
+                id:       comp.id,
+                h:        comp.horizontal_sample as u8,
+                v:        comp.vertical_sample as u8,
+                qt_index: comp.quantization_table_number,
+                width:    plane.width,
+                height:   plane.height,
+                samples:  plane.samples,
+            })
+            .collect();
+
+        Ok(JpegPlanes {
+            width: usize::from(self.info.width),
+            height: usize::from(self.info.height),
+            components,
+            qt,
+            restart_interval: u16::try_from(self.restart_interval).unwrap_or(u16::MAX),
+            progressive: self.is_progressive,
+        })
+    }
+
+    /// Copy row of MCUs `i` of every component — `raw_coeff`, the IDCT's
+    /// output, `width_stride` samples a row and `8 · v` rows — into its
+    /// plane, up to the plane's own width and height. Called by
+    /// `post_process` in place of upsampling and colour conversion.
+    // A sample clamped to 0–255 first.
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    pub(crate) fn copy_planes(&mut self, i: usize) -> Result<(), DecodeErrors> {
+        let width = usize::from(self.info.width);
+        let height = usize::from(self.info.height);
+        if self.planes.is_empty() {
+            for comp in &self.components {
+                let w = (width * comp.horizontal_sample).div_ceil(self.h_max);
+                let h = (height * comp.vertical_sample).div_ceil(self.v_max);
+                self.planes.push(PlaneBuf {
+                    width:   w,
+                    height:  h,
+                    samples: vec![128; w * h],
+                });
+            }
+        }
+        for (comp, plane) in self.components.iter().zip(self.planes.iter_mut()) {
+            let stride = comp.width_stride;
+            if stride == 0 || plane.width == 0 {
+                continue;
+            }
+            let rows = comp.raw_coeff.len() / stride;
+            for r in 0..rows {
+                let y = i * rows + r;
+                if y >= plane.height {
+                    break;
+                }
+                let source = comp
+                    .raw_coeff
+                    .get(r * stride..r * stride + plane.width)
+                    .ok_or(DecodeErrors::FormatStatic("Plane wider than its row of MCUs"))?;
+                let row = &mut plane.samples[y * plane.width..(y + 1) * plane.width];
+                for (out, &sample) in row.iter_mut().zip(source) {
+                    *out = sample.clamp(0, 255) as u8;
+                }
+            }
+        }
+        Ok(())
+    }
+}
