#!/usr/bin/env bash
#
# Pre-commit hook: scan staged changes for secrets using gitleaks.
#
# Install: ./scripts/install-hooks.sh
# Requires: gitleaks (https://github.com/gitleaks/gitleaks#installing)
#
# With the developer repository at dev/ (scripts/dev-checkout.sh) the scan
# also holds the private rules in dev/gitleaks-local.toml: no developer
# document, no path into a developer's machine, no machine's name and no
# private infrastructure in a public commit. They are private because the
# patterns name those things; without dev/ the scan is .gitleaks.toml's alone,
# as in CI.
#

set -euo pipefail

# Check if gitleaks is installed
if ! command -v gitleaks &>/dev/null; then
  echo "WARNING: gitleaks is not installed — skipping secret scan."
  echo "Install it to enable pre-commit secret detection:"
  echo "  brew install gitleaks          # macOS"
  echo "  scoop install gitleaks         # Windows"
  echo "  https://github.com/gitleaks/gitleaks#installing"
  exit 0
fi

config=.gitleaks.toml
if [ -f dev/gitleaks-local.toml ]; then
  config=dev/gitleaks-local.toml
fi

echo "Running gitleaks on staged changes ($config)..."

# --staged scans only what's about to be committed
gitleaks git --staged --verbose --redact --config "$config"

echo "No secrets detected."
